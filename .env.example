# ============================================================================
# Lunex Bot — Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---- Runtime -----------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- Blockchain / RPC ----------------------------------------------------
# Robinhood Chain (chain id 4663, an Arbitrum-based L2). Values below are
# VERIFIED from public sources (see README "LIVE VALIDATION CHECKLIST"):
#   - Official RPC (Robinhood-operated, from the ethereum-lists chain
#     registry, https://github.com/ethereum-lists/chains/blob/master/_data/chains/eip155-4663.json):
#       https://rpc.mainnet.chain.robinhood.com
#     NOTE: verify reachability from YOUR network before relying on it —
#     some networks/regions cannot reach it. If unreachable, run the bot
#     behind a paid archive-capable RPC; the free community endpoints below
#     DO NOT serve historical (archive) state, which pool discovery and
#     reconciliation need:
#       https://robinhood-rpc.publicnode.com   (PublicNode; archive needs a token)
#       https://rpc.ordofi.network             (live, no archive)
#   - Fallbacks, comma-separated:
RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_FALLBACK_URLS=https://robinhood-rpc.publicnode.com
# Verified: the chain reports eth_chainId 0x1237 = 4663 (live-checked).
CHAIN_ID=4663

# Executor wallet. REQUIRED — OPERATOR MUST PROVIDE. This key signs every
# deploy/exit transaction — treat it as production secret material
# (KMS/HSM/vault in real deployment; a plain env var is a development-only
# placeholder). NEVER paste a real private key into chat, issues, or logs.
PRIVATE_KEY=0xREPLACE_WITH_EXECUTOR_PRIVATE_KEY

# ---- Token / Protocol addresses ------------------------------------------
# REQUIRED — OPERATOR MUST PROVIDE: the USDG stablecoin's contract address on
# Robinhood Chain. Public sources for verifying it: the Robinhood Chain
# explorers (https://robinscan.io, https://hoodscan.co) or the chain's
# official token list. Not filled here because this repository has no
# independent verification of it yet — do NOT guess.
USDG_TOKEN_ADDRESS=0xREPLACE_WITH_USDG_ADDRESS
# Real Robinhood Chain USDG decimals() = 6 (confirmed via eth_call) -- do
# NOT assume 18 like most ERC20s. Verify against your own deployment's USDG
# contract before trusting this default.
USDG_DECIMALS=6

# Uniswap deployment addresses on Robinhood Chain. PHASE 5: every address
# below marked "confirmed" matches the Trading API's OWN address book
# (GET https://trade-api.gateway.uniswap.org/v1/supported_chains?chainIds=4663
# -- public, no auth), which is the authoritative per-chain source.
# Addresses for chains other than Robinhood differ -- never copy these
# onto another chain.
# Legacy V2/V3 pair (not used by the v4-only trading path, but confirmed):
#   UniswapV2Factory  0x8bcEaA40B9AcdfAedF85AdF4FF01F5Ad6517937f
#   UniswapV2Router02 0x89e5DB8B5aA49aA85AC63f691524311AEB649eba
#   UniswapV3Factory  0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
UNISWAP_V2_FACTORY_ADDRESS=
UNISWAP_V2_ROUTER_ADDRESS=
UNISWAP_V3_FACTORY_ADDRESS=
UNISWAP_V3_QUOTER_ADDRESS=
UNISWAP_V3_SWAP_ROUTER_ADDRESS=
UNISWAP_V3_NFT_POSITION_MANAGER_ADDRESS=
# Confirmed Robinhood Chain deployment address (Trading API address book).
# pools/poolStateProvider.ts self-checks this against
# UNISWAP_V4_STATE_VIEW_ADDRESS at runtime via StateView.poolManager() --
# if you override one without the other, startup will fail loudly.
UNISWAP_V4_POOL_MANAGER_ADDRESS=0x8366a39cc670b4001a1121b8f6a443a643e40951
# Block PoolManager was deployed at — lower bound for the Initialize/Swap
# log scans pools/ uses for pool discovery and 6H volume estimation.
# VERIFIED (README "LIVE VALIDATION CHECKLIST" has the full evidence):
# creation tx 0x4fb28d4935866f462582c6c931c6f2705e55f5be5eb178c7d8d9329a95c44c41
# mined in block 9070 (2026-05-22), internal create2 createdContract =
# 0x8366a39cc670b4001a1121b8f6a443a643e40951 — cross-checked against BOTH
# the robinscan index and a live node's eth_getTransactionByHash.
UNISWAP_V4_POOL_MANAGER_DEPLOY_BLOCK=9070
UNISWAP_V4_QUOTER_ADDRESS=
# Confirmed Robinhood Chain deployment address (Trading API address book):
# PositionManager 0x58daec3116aae6d93017baaea7749052e8a04fa7
UNISWAP_V4_POSITION_MANAGER_ADDRESS=0x58daec3116aae6d93017baaea7749052e8a04fa7
# Block the PositionManager was deployed at — lower bound for the ERC721
# Transfer-log scan reconciliation/'s orphan-NFT detection uses.
# VERIFIED: creation tx 0x228c18ada6cb46b4fbcc18f4ec1519953415393e256fa8349aafbd5a2db037c8
# mined in block 9073 (2026-05-22), internal create2 createdContract =
# 0x58daec3116aae6d93017baaea7749052e8a04fa7 — cross-checked against BOTH
# the robinscan index and a live node's eth_getTransactionByHash.
UNISWAP_V4_POSITION_MANAGER_DEPLOY_BLOCK=9073
# Periphery StateView contract — standard way to read v4 pool state
# (slot0/liquidity/ticks) off-chain without an indexer. Confirmed
# Robinhood Chain deployment address (Trading API address book).
UNISWAP_V4_STATE_VIEW_ADDRESS=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b
UNISWAPX_REACTOR_ADDRESS=

# ---- Uniswap Trading API (required -- the exit flow's TOKEN->USDG swap) --
# REQUIRED — OPERATOR MUST PROVIDE. Get a key from
# https://trade-api.gateway.uniswap.org (or your Uniswap Labs API access).
# Required: the bot refuses to start without it, since every position
# close depends on it. Never commit the real key; pass it via your secret
# manager or a local .env that is gitignored.
UNISWAP_API_KEY=
# Real, documented public endpoint (confirmed against the live OpenAPI
# spec at https://trade-api.gateway.uniswap.org/v1/api.json). Override
# only if you have a different approved base URL.
UNISWAP_TRADING_API_BASE_URL=https://trade-api.gateway.uniswap.org
# The ONLY contract address exit-swap calldata is allowed to target.
# PHASE 5: CONFIRMED from the Trading API's own address book for chain
# 4663 (GET /v1/supported_chains?chainIds=4663 -- public, no auth):
#   UniversalRouter 0x8876789976dEcBfCbBbe364623C63652db8C0904
# This is the router the Trading API builds classic-swap calldata for on
# Robinhood Chain. Until this is set, validateSwapQuote.ts FAILS CLOSED
# (rejects every swap) rather than guess -- fill it in before the exit
# flow's swap leg can work at all.
UNISWAP_ALLOWED_SWAP_ROUTER_ADDRESS=0x8876789976dEcBfCbBbe364623C63652db8C0904

# ---- GMGN (discovery data source) ----------------------------------------
# Accessed via the `gmgn-cli` tool (spawned as a child process), not a
# direct HTTP call. GMGN_CLI_PATH can be a bare command (resolved via PATH)
# or an absolute path to the binary.
GMGN_CLI_PATH=gmgn-cli
# Passed to the child process via env (never as a CLI argument, so it never
# shows up in `ps`/task manager output).
GMGN_API_KEY=
# Kept only in case a future gmgn-cli build supports an API host override;
# not currently passed to the CLI.
GMGN_BASE_URL=

# ---- Database --------------------------------------------------------------
# DATABASE_PROVIDER: "sqlite" (default, local file) or "postgresql"
# (recommended for production / multi-instance deployments).
DATABASE_PROVIDER=sqlite
# For sqlite:   file:./data/lunex.db
# For postgres: postgresql://user:password@host:5432/lunex
DATABASE_URL=file:./data/lunex.db

# ---- Backend API (single source of truth) ---------------------------------
API_PORT=8443
API_HOST=0.0.0.0
# HTTPS is mandatory (no IP whitelist is used, per spec) — provide a cert/key
# pair, or terminate TLS at a reverse proxy and set API_TRUST_PROXY=true.
API_HTTPS_CERT_PATH=
API_HTTPS_KEY_PATH=
API_TRUST_PROXY=false
API_CORS_ORIGIN=

# ---- Auth (username + password, session tokens) ---------------------------
AUTH_ADMIN_USERNAME=admin
# Store only a bcrypt hash of the password — never the plaintext.
# Generate with: node -e "console.log(require('bcrypt').hashSync('yourpassword',12))"
AUTH_ADMIN_PASSWORD_HASH=
# Module 11: plaintext, used ONLY by telegram/'s own bot-to-API login
# (POST /auth/login) -- a same-host, unattended process has no human to
# prompt for a password at boot. Required if TELEGRAM_BOT_TOKEN is set
# (process refuses to start otherwise); leave both empty to disable
# Telegram entirely. MUST be the same real password AUTH_ADMIN_PASSWORD_HASH
# was hashed from -- no automatic check is possible (bcrypt is one-way), a
# mismatch just shows up as a failed bot login at startup. See README's
# Module 11 section for why this reuses the admin credential instead of a
# separate service token.
AUTH_ADMIN_PASSWORD=
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# ---- Telegram (control & on-demand reporting only, no push notifications) -
# Leave empty to disable the Telegram integration entirely.
# Format: <bot_id>:<35-char-secret> (validated).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=Lunex Bot
# Comma-separated Telegram user IDs allowed to issue commands to the bot.
# Required (non-empty) for the bot to respond to anyone -- if
# TELEGRAM_BOT_TOKEN is set and this is left empty, the bot starts and logs
# in fine but silently drops every incoming message (see README's Module 11
# section) -- a startup warning is logged either way.
TELEGRAM_AUTHORIZED_USER_IDS=

# ---- Capital management (unlocked / TBD parameters) ------------------------
# ETH gas reserve mechanism is intentionally NOT finalized. Leave disabled
# (0 / false) until a real value is decided — see src/config/constants.ts.
ETH_GAS_RESERVE_ENABLED=false
ETH_GAS_RESERVE_MIN=0

# ---- Exit safety toggles --------------------------------------------------
# TIER 3: the exit price-impact check is now ON by default, enforcing
# PRICE_IMPACT.MAX_EXIT_IMPACT_PCT (0.5%, Meridian `maxExitPriceImpactPct`)
# against a FRESH quote taken at exit time. A blocked exit defers (PENDING)
# and is retried next tick -- it is never a definitive failure, and the
# TOKEN balance is never abandoned. Set to false only to deliberately
# disable the gate.
EXIT_IMPACT_CHECK_ENABLED=true
# Post-hoc balance-delta minimum, defence-in-depth behind the on-chain
# bound that is now ALWAYS requested from the router at the current
# slippage tier (100 -> 200 -> 300 bps). Still off by default.
EXIT_MIN_RECEIVED_PROTECTION_ENABLED=false
