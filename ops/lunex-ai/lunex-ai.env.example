# Lunex AI supervisor environment -- template for /opt/lunex/ai/lunex-ai.env
# Owner lunex-ai:lunex-ai, mode 0600 (10-install.sh enforces this).
# NEVER commit the real file. Fill in the values on the VPS with:
#   sudoedit /opt/lunex/ai/lunex-ai.env

# ---- Required secrets (the operator enters these on the VPS) ---------------
# Token of the DEDICATED Lunex AI control bot from @BotFather.
# Never the Lunex trading bot's token: two processes long-polling the same
# token make one of them fail (HTTP 409).
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user id(s) allowed to control the AI, comma-separated.
TELEGRAM_ADMIN_ID=
# TokenRouter API key.
TOKENROUTER_API_KEY=

# ---- Model gateway ----------------------------------------------------------
LUNEX_AI_MODEL=z-ai/glm-5.3-free
LUNEX_AI_BASE_URL=https://api.tokenrouter.com/v1

# ---- Paths (defaults shown) ---------------------------------------------------
# LUNEX_AI_WORKSPACE=/opt/lunex/workspace/lunex
# LUNEX_AI_HOME=/opt/lunex/ai
# Always denied in code: /opt/lunex/production, /opt/lunex/trading,
# /opt/finance-bot, /opt/guardian, /root. Add more, comma-separated:
# LUNEX_AI_EXTRA_DENIED_PATHS=

# ---- Behaviour (defaults shown) -----------------------------------------------
# LUNEX_AI_INTEGRATION_BRANCH=ai/develop
# LUNEX_AI_MAX_AGENT_STEPS=60
# LUNEX_AI_MAX_DEBUG_ROUNDS=3
# LUNEX_AI_COMMAND_TIMEOUT_MS=900000
# LUNEX_AI_LLM_TIMEOUT_MS=300000
# LUNEX_AI_AUTONOMOUS_IDLE=true
# LUNEX_AI_IDLE_TASK_COOLDOWN_MS=1800000
# LUNEX_AI_MAX_SELF_TASKS_PER_DAY=10
# LUNEX_AI_REPLY_UNAUTHORIZED=false
