# Lunex AI supervisor environment -- copy to /opt/lunex/ai/lunex-ai.env
# (owner root:lunex-ai, mode 0640). NEVER commit the real file.
#
# Only names are listed here. Fill in the values on the VPS yourself.

# ---- Required secrets (the operator enters these on the VPS) ---------------
# Token of the dedicated Lunex AI CONTROL bot from @BotFather.
# MUST be a different bot from the Lunex trading bot's own TELEGRAM_BOT_TOKEN:
# two processes long-polling the same token make one of them fail (HTTP 409).
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user id(s) allowed to control the AI, comma-separated.
TELEGRAM_ADMIN_ID=
# TokenRouter API key.
TOKENROUTER_API_KEY=

# ---- Model gateway (optional overrides) -------------------------------------
# TOKENROUTER_BASE_URL=https://api.tokenrouter.io/v1
# LUNEX_AI_MODEL=z-ai/glm-5.3-free

# ---- Paths (defaults shown) ---------------------------------------------------
# LUNEX_AI_WORKSPACE=/opt/lunex/workspace/lunex
# LUNEX_AI_HOME=/opt/lunex/ai
# Extra paths the supervisor must never touch, comma-separated (production, trading and /root are always denied).
# LUNEX_AI_EXTRA_DENIED_PATHS=/opt/other-bots

# ---- Behaviour (defaults shown) -----------------------------------------------
# LUNEX_AI_INTEGRATION_BRANCH=ai/develop
# LUNEX_AI_MAX_AGENT_STEPS=60
# LUNEX_AI_MAX_DEBUG_ROUNDS=3
# LUNEX_AI_COMMAND_TIMEOUT_MS=900000
# LUNEX_AI_LLM_TIMEOUT_MS=300000
# LUNEX_AI_AUTONOMOUS_IDLE=true
# LUNEX_AI_IDLE_TASK_COOLDOWN_MS=1800000
# LUNEX_AI_MAX_SELF_TASKS_PER_DAY=10
# LUNEX_AI_REPLY_UNAUTHORIZED=false
