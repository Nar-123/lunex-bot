# Lunex AI development supervisor -- Telegram-controlled, development only.
# It never trades, never deploys, and must not be able to see production or
# the other projects on this VPS. Installed by ops/lunex-ai/deploy/10-install.sh,
# which substitutes the real node path into ExecStart/Environment=PATH.
[Unit]
Description=Lunex AI development supervisor (Telegram control, no trading)
Documentation=file:///opt/lunex/workspace/lunex/ops/lunex-ai/DEPLOYMENT.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=lunex-ai
Group=lunex-ai
UMask=0027

# The deployed build lives in /opt/lunex/ai/lunex-ai, OUTSIDE the workspace and
# read-only for the service: edits in ops/lunex-ai/ never take effect without an
# operator redeploy.
WorkingDirectory=/opt/lunex/workspace/lunex
EnvironmentFile=/opt/lunex/ai/lunex-ai.env
Environment=NODE_ENV=production
Environment=HOME=/opt/lunex/ai/home
Environment=npm_config_cache=/opt/lunex/ai/home/.npm
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/node /opt/lunex/ai/lunex-ai/dist/main.js

Restart=always
RestartSec=10
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=60

# ---- Share a small VPS fairly with the other services on it --------------
Nice=10
CPUQuota=150%
MemoryHigh=1536M
MemoryMax=2048M
TasksMax=512

# ---- OS-level scope enforcement (in addition to the in-code scope guard) ----
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
# Writable: the Lunex workspace and the AI home only. Everything else is read-only (ProtectSystem=strict).
ReadWritePaths=/opt/lunex/workspace/lunex /opt/lunex/ai
# ...except the deployed supervisor, its secrets file and the source bundle ("-" = ignore if absent).
ReadOnlyPaths=-/opt/lunex/ai/lunex-ai -/opt/lunex/ai/lunex-ai.env -/opt/lunex/ai/lunex.bundle
# Invisible to this service even if Unix permissions on them are ever too open.
InaccessiblePaths=-/opt/finance-bot -/opt/guardian -/opt/lunex/production -/opt/lunex/trading -/root -/etc/lunex -/opt/other-bots

[Install]
WantedBy=multi-user.target
