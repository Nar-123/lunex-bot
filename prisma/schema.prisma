// Lunex Bot — Prisma schema
//
// Models are added incrementally, module by module, as each module actually
// needs persisted state. See README.md "Module status" for what's
// implemented so far.
//
// Provider note: `provider` below targets SQLite (matches
// DATABASE_PROVIDER=sqlite in .env.example) -- this is a SQL-DIALECT choice
// fixed at schema/migration time, not a runtime switch. Prisma 7 removed
// `datasource.url` from this file entirely (schema validation now rejects
// it, error P1012); the connection URL for migrations lives in
// `prisma7.config.ts` at the repo root, and the app's own runtime
// connection (`storage/prismaClient.ts`) builds an explicit driver adapter
// (`@prisma/adapter-better-sqlite3` / `@prisma/adapter-pg`) from
// `config.database`, since Prisma 7 requires `new PrismaClient({ adapter })`
// -- there is no more implicit "reads DATABASE_URL and connects."
// Switching to Postgres for production means: change `provider` below to
// "postgresql", run `prisma migrate dev` to regenerate migrations, and set
// DATABASE_PROVIDER=postgresql (so `storage/prismaClient.ts` picks the pg
// adapter) -- still a small, explicit change, never silently runtime-swapped.
datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

/// Per-token post-exit cooldown (2h, per spec) -- NEVER a global cooldown.
/// One row per token that has ever exited; upserted on every exit.
model TokenCooldown {
  /// Lowercased EVM address -- always normalized before read/write so
  /// lookups can't miss due to checksum-casing differences.
  tokenAddress   String   @id
  exitedAt       DateTime
  cooldownEndsAt DateTime
  updatedAt      DateTime @updatedAt

  @@index([cooldownEndsAt])
}

/// Tracks every critical on-chain operation (deploy or exit) through the
/// mandatory Build -> Simulate -> Gas Check -> Nonce Check -> Send ->
/// Wait Receipt -> Verify On-chain -> Update State pipeline.
///
/// This is what makes the pipeline crash-safe: `idempotencyKey` lets a
/// resumed process find an in-flight attempt instead of starting a new
/// one (which could double-spend or double-nonce), and `rawTx`/`txHash`
/// are persisted BEFORE broadcasting -- computed from the locally-signed
/// transaction, not from the broadcast response -- so even if the actual
/// broadcast call throws/times out (network blip, RPC drop), a resumed
/// process already knows the exact hash to look up on-chain rather than
/// guessing whether anything was sent at all.
model TransactionAttempt {
  id             String   @id @default(cuid())
  /// Caller-supplied, unique per logical operation (e.g.
  /// "deploy:0xTOKEN:2026-09-06T12:00:00Z" or "exit:positionId=42"). The
  /// one thing every idempotency/resume decision keys off of.
  idempotencyKey String   @unique
  /// Free-form description for logs/diagnostics only.
  purpose        String
  status         String
  /// JSON-encoded {to, data, value} -- persisted once built so a resumed
  /// process re-verifies against the SAME request rather than rebuilding
  /// (and potentially computing subtly different calldata).
  txRequest      String?
  gasLimit       BigInt?
  gasPrice       BigInt?
  nonce          Int?
  rawTx          String?
  txHash         String?
  lastError      String?
  /// JSON-encoded verification payload (e.g. mint's {positionTokenId,
  /// liquidity}), persisted atomically with status VERIFIED. This is what
  /// makes a VERIFIED attempt's result recoverable after a crash: without
  /// it, a resumed process that finds status already VERIFIED would have
  /// no way to hand the caller the data it needs (see
  /// execution/executeCriticalTransaction.ts's VERIFIED short-circuit).
  /// Nullable for two reasons: attempts created before this column existed,
  /// and attempts whose TVerifyData is genuinely `undefined`/void.
  verifyData     String?
  /// Set only when status is FAILED -- distinguishes WHY: rejected pre-broadcast
  /// (SIMULATION_REJECTED / GAS_UNAFFORDABLE), rejected synchronously by the node
  /// at broadcast time (BROADCAST_REJECTED -- e.g. nonce too low, insufficient
  /// funds), reverted after being mined (REVERTED), or confirmed but failed a
  /// post-hoc business check (VERIFICATION_FAILED). Added per explicit review --
  /// not part of the original spec's status list, but needed so a stuck/failed
  /// attempt's root cause is queryable (e.g. a future `/status` command) without
  /// parsing `lastError` free text.
  failureCode    String?
  /// How many times `executeCriticalTransaction` has been called for this
  /// key and actually done pipeline work (short-circuited VERIFIED/FAILED
  /// re-checks don't count). Added per explicit review, for stuck-attempt
  /// detection -- see `execution/stuckAttempt.ts`.
  attemptCount     Int       @default(0)
  /// Set on the first non-short-circuited call. Combined with
  /// `attemptCount`, lets a resumable-but-not-progressing attempt (stuck
  /// in an ambiguous state) be found by query -- e.g. "non-terminal AND
  /// older than 10 minutes" -- without any push notification (Telegram
  /// stays on-demand-only per spec).
  firstAttemptedAt DateTime?
  /// P1-5 fix: optimistic-concurrency version, incremented by exactly 1 on
  /// every successful `update()`. `update()`'s optional `expectedVersion`
  /// parameter makes the write a compare-and-swap (`WHERE id = ? AND
  /// version = ?`) -- see `execution/types.ts`'s doc comment on `update()`
  /// for why this exists: without it, a stale worker (a second process, or
  /// a crashed-and-resumed call racing a newer one) could silently
  /// overwrite newer pipeline progress with an older snapshot.
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

/// One row per LP position, active or historical. The source of truth
/// for "1 coin = 1 active position" (queried by tokenAddress + status)
/// and for capital/'s `totalDeployedUsdg` (sum of `entryUsdgRaw` across
/// ACTIVE rows) -- both were left as honest gaps in Module 5 pending
/// this model existing.
model Position {
  id             String  @id @default(cuid())
  /// Lowercased EVM address -- normalized the same way as
  /// TokenCooldown.tokenAddress, so lookups can't miss on casing.
  tokenAddress   String
  tokenSymbol    String
  tokenDecimals  Int
  /// v4 pool id (bytes32 hex) and the full PoolKey, decomposed (not a
  /// JSON blob) so monitoring/ can reconstruct a `v4Sdk.Pool` without
  /// re-parsing -- these came from `pools/` (Module 3) at selection time
  /// and never change for this position's lifetime.
  poolId         String
  currency0      String
  currency1      String
  fee            Int
  tickSpacing    Int
  hooks          String
  tickLower      Int
  tickUpper      Int
  /// PositionManager NFT tokenId -- set once the open transaction is
  /// verified on-chain, not before (per the transaction-safety pipeline:
  /// never record state that hasn't been confirmed).
  positionTokenId String?
  /// Amount deployed at entry (35% of free USDG balance, per capital/),
  /// raw units, as a decimal STRING -- not BigInt. VERIFIED (an earlier
  /// version of this schema used BigInt and it broke immediately in the
  /// real-SQLite integration test): a routine 18-decimal USDG amount
  /// like 1000 USDG = 1000 * 10^18 already exceeds SQLite's 64-bit
  /// signed INTEGER range that Prisma's BigInt column maps to (max
  /// ~9.2 * 10^18) -- this is not an edge case, it's the normal case for
  /// any token with 18 decimals. The PNL basis -- never recomputed,
  /// since "entry" is a point-in-time fact.
  entryUsdgRaw   String
  /// sqrtPriceX96 at entry, as a decimal STRING -- not BigInt, same
  /// reasoning: Uniswap's sqrtPriceX96 can reach ~2^160, also far beyond
  /// the 64-bit range.
  entrySqrtPriceX96 String
  entryTick      Int
  status         String // OPENING | ACTIVE | CLOSING | CLOSED | FAILED
  /// Ties this position to the `TransactionAttempt` that opened it.
  openIdempotencyKey  String  @unique
  /// Ties this position to the `TransactionAttempt` that closed it, once
  /// exiting starts (Module 8, exits/ -- not built yet).
  closeIdempotencyKey String? @unique
  openedAt       DateTime?
  closedAt       DateTime?
  closeReason    String?
  /// VALIDATION PHASE: total USDG (raw) this position's exit actually
  /// returned to the wallet, measured from the CONFIRMED receipts of the
  /// remove-liquidity and swap transactions (ERC20 Transfer logs to the
  /// wallet, summed). NULL = not (yet) measured -- honestly unavailable,
  /// never 0-as-placeholder: a position closed by legacy code, or whose
  /// receipts could not be decoded, reports no realized number rather
  /// than a fabricated one. Realized PnL = realizedUsdgRaw - entryUsdgRaw
  /// (computed at read time in reporting; only the measured proceeds are
  /// stored). Decimal STRING, same SQLite-overflow reason as entryUsdgRaw.
  realizedUsdgRaw String?
  /// C7 concurrency fix: set by `PositionRepository.claimForResume()`'s
  /// atomic `UPDATE ... WHERE id = ? AND status = ?` compare-and-swap --
  /// makes "which process/cycle gets to resume this position" a single
  /// atomic DB operation instead of a racy read-then-act. Also doubles as
  /// the freshness signal: a claim within the freshness window is refused,
  /// so a position someone is actively working on right now can't be
  /// immediately re-claimed by a second concurrent cycle (e.g. the 30-min
  /// screening cycle's `openPosition()` and the 15s exit cycle's
  /// OPENING-resume pass both discovering the same brand-new position).
  resumeClaimedAt DateTime?
  /// P0-1 fix: a random per-claim ownership token, set atomically together
  /// with `resumeClaimedAt` by `claimForResume()`. `releaseResumeClaim()`
  /// now requires the CALLER's own token to match this column (`UPDATE ...
  /// WHERE id = ? AND resumeClaimToken = ?`) before it clears the claim --
  /// closing the race where a worker that hung past claim expiry (so a
  /// second worker legitimately re-claimed the same row) later returns and
  /// unconditionally releases, deleting the SECOND worker's still-active
  /// claim out from under it. NULL = unclaimed, same as `resumeClaimedAt`.
  resumeClaimToken String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([tokenAddress, status])
  // P1-2 fix: a partial UNIQUE index -- `Position_tokenAddress_active_unique`
  // ON ("tokenAddress") WHERE "status" IN ('OPENING','ACTIVE','CLOSING') --
  // is applied via raw SQL in migration
  // `20260916000002_add_position_token_active_unique_index`, NOT expressed
  // here, because Prisma's declarative `@@unique` cannot express a WHERE
  // condition. This is what makes "1 token = 1 non-closed position" a
  // DB-atomic invariant (a concurrent `create()` for the same token while
  // one is already OPENING/ACTIVE/CLOSING fails at the database level)
  // rather than a racy application-level check-then-create. Do NOT remove
  // this index by "fixing" apparent schema drift -- it is intentionally
  // absent from the declarative model above.
}

/// Persistent state for exits/'s stateful exit triggers (Module 8) — Trailing
/// TP's peak/drawdown-confirm timer and OOR's grace timer MUST survive a bot
/// restart mid-countdown (same principle as TransactionAttempt's crash-safety
/// for Module 6), so none of this lives in an in-memory variable. One row per
/// position, created lazily on first use by exits/, not by positions/create()
/// — kept decoupled the same way TokenCooldown is its own standalone table
/// rather than a Position column, since exits/ owns this state, not positions/.
model ExitState {
  positionId String @id

  /// Highest PNL % ever observed once Trailing TP has armed (null = not yet
  /// armed). Armed once PNL reaches the effective threshold (+5% normally,
  /// 0% once PNL Protection has activated, see pnlProtectionActivatedAt).
  trailingPeakPnlPct Float?
  /// Set the moment PNL first breaches (peak - 2%) after arming; cleared the
  /// moment PNL recovers back above that line OR a new peak is set. Trailing
  /// TP closes once `now - this >= EXITS.TRAILING_TP.CONFIRM_WINDOW_MS`.
  drawdownConfirmStartedAt DateTime?
  /// Set the moment price first goes out of [tickLower, tickUpper); cleared
  /// the moment it's back in range. OOR closes once
  /// `now - this >= EXITS.OOR.GRACE_WINDOW_MS`.
  oorStartedAt DateTime?
  /// TIER 3 (renamed from pnlProtectionActivatedAt, same arming
  /// condition so existing rows carry over): set ONCE, the first time this
  /// position's MAXIMUM DRAWDOWN reached EXITS.SAFETY_EXIT.TRIGGER_PCT
  /// (-8%). Sticky — never cleared, so a later dip back below the target
  /// cannot disarm it and a restart cannot forget it. Non-null means the
  /// position closes as soon as PnL recovers to
  /// EXITS.SAFETY_EXIT.TARGET_PCT (0%).
  safetyExitArmedAt DateTime?
  /// TIER 3: the most negative PnL ever observed for this position, as a
  /// fraction. Only ever moves down. Safety Exit arms against THIS rather
  /// than against the current reading, so a position that dips to -9% and
  /// bounces back to -1% between two 15s polls still arms.
  maxDrawdownPnlPct Float?
  /// Set on the first tick this position's live metrics fail to read
  /// (PositionMetricsResult.ok === false); cleared on the next successful
  /// read. Safety Exit condition (a) — see EXITS.SAFETY_EXIT in constants.ts.
  metricsFailureSince DateTime?
  /// Incremented every time the exit SWAP sub-transaction (not the
  /// remove-liquidity one) is found FAILED (definitive). Used to derive a
  /// FRESH idempotencyKey for each swap retry
  /// (`${closeIdempotencyKey}:swap:${swapAttemptCount}`) — reusing the same
  /// key would make executeCriticalTransaction return the cached FAILED
  /// result forever (see exits/executeExit.ts). Also the basis for
  /// EXITS.SWAP_RETRY.STUCK_THRESHOLD detection.
  swapAttemptCount Int @default(0)
  /// USDG balance observed the moment the CURRENT swap attempt's tx was
  /// built -- decimal STRING, not BigInt/Int, same 64-bit-overflow reason
  /// as Position.entryUsdgRaw (an 18-decimal USDG amount routinely exceeds
  /// SQLite's signed-INTEGER range). Set once per attempt (inside
  /// exits/swapTx.ts's buildTransaction, which runs exactly once and is
  /// skipped on resume) so a resumed verifyOnChain call -- potentially in a
  /// different process after a restart -- still has the correct baseline.
  swapUsdgBalanceBeforeRaw String?
  /// Minimum USDG increase required for the CURRENT swap attempt to verify
  /// as successful (decimal STRING, same overflow reasoning) -- 0/absent
  /// when EXITS.MIN_RECEIVED_PROTECTION_ENABLED is false, in which case
  /// verification degrades to "genuinely increased at all."
  swapMinOutputAmountRaw String?
  /// USDG increase the CURRENT swap attempt's balance check already
  /// accepted (decimal STRING, same overflow reasoning). Reset to null when
  /// a new attempt is built; lets a resumed verifyOnChain (after a failed
  /// proceeds read) skip re-reading a balance that concurrent wallet
  /// activity may since have moved. See exits/swapTx.ts.
  swapVerifiedUsdgIncreaseRaw String?
  /// The exit-trigger reason (SAFETY_EXIT/HARD_STOP_LOSS/TRAILING_TP/OOR)
  /// recorded at the moment markClosing() is called — read back to pass to
  /// markClosed() once the exit actually completes, potentially ticks or a
  /// restart later. Must be persisted here, not carried in a JS variable
  /// across the two DB writes, since a restart can happen in between.
  pendingCloseReason String?

  updatedAt DateTime @updatedAt

  @@index([oorStartedAt])
  @@index([drawdownConfirmStartedAt])
}

/// TIER 3: rolling pool-price history, the data source for Bollinger %B
/// (monitoring/bollinger.ts) and therefore for the OVEREXTENDED exit.
///
/// One row per pool per monitoring tick (~15s), collapsed into 5-minute
/// "closes" at read time. Persistent rather than in-memory for the same
/// reason every exit timer is: after a restart the bot must reach the SAME
/// decision it would have reached without one, and an in-memory window
/// would report %B unavailable for a full 100 minutes (20 x 5min) every
/// time the process starts.
///
/// Bounded by PriceHistoryProvider.pruneOlderThan, called each exit-cycle
/// tick -- without it this table grows forever at ~4 rows/min/pool.
model PoolPriceSample {
  id         String   @id @default(cuid())
  /// v4 pool id (bytes32 hex) -- keyed by POOL, not by position: several
  /// positions can share a pool and the price series belongs to the pool.
  poolId     String
  /// USDG per TOKEN, as a decimal STRING. Not Float: SQLite's REAL is
  /// binary floating point and silently perturbs the last digits on
  /// round-trip; a string round-trips exactly (same reasoning as
  /// Position.entryUsdgRaw, different underlying cause).
  price      String
  observedAt DateTime

  @@index([poolId, observedAt])
  @@index([observedAt])
}

/// P1-1 fix: singleton advisory-lock row for
/// `PositionRepository.createIfCapitalAllows()`'s capital-reservation
/// critical section. That method's `$transaction` touches this row (a real
/// WRITE) as its FIRST statement, before doing any reads -- this is what
/// forces SQLite to escalate the (otherwise-deferred) transaction's lock to
/// a genuine RESERVED write lock immediately, rather than only at the final
/// `position.create()`. Without this, two concurrent callers could both
/// complete their `findMany`/`count` reads (a SHARED lock, which SQLite
/// lets multiple readers hold at once) before either takes the write lock,
/// each computing "fits under the cap" from the SAME stale totals and then
/// both writing -- exactly the race this method must prevent, and the one
/// a Prisma `{ isolationLevel: 'Serializable' }` option does NOT prevent:
/// verified empirically (see git history on this file) that Prisma's
/// better-sqlite3 driver adapter's `startTransaction()` always issues a
/// plain `BEGIN` regardless of the requested isolation level. This matters
/// most ACROSS SEPARATE PROCESSES -- each has its own independent Prisma
/// driver adapter and its own in-process JS mutex (see
/// `@prisma/adapter-better-sqlite3`'s `PrismaBetterSqlite3Adapter#mutex`),
/// which does NOT coordinate with any other process; only a real SQLite
/// file-level write lock does. This row is never read for its data --
/// touched and thrown away every time.
///
/// `id` deliberately has NO `@default`: the single row is seeded (with an
/// explicit id) by migration `20260916000003_add_capital_lock`, and the only
/// runtime access is `update({ where: { id: 'singleton' } })` -- nothing
/// ever inserts via Prisma. Declaring `@default("singleton")` here (as an
/// earlier revision did) made the schema claim a SQL `DEFAULT 'singleton'`
/// the migration never created, so `prisma migrate diff`/`migrate dev`
/// reported drift and would have generated a gratuitous table-rebuild
/// migration. Keeping the schema aligned with the migration avoids that
/// with no database change at all. If the row is ever missing, the
/// `update` throws and `createIfCapitalAllows` fails closed (no reservation).
model CapitalLock {
  id        String   @id
  touchedAt DateTime @updatedAt
}

/// Live, operator-editable parameters (Module 10) -- singleton row (`id`
/// always "singleton", exactly one bot instance). Defaults below match
/// today's frozen `config.rules.*` constants exactly, so behavior is
/// byte-identical to pre-Module-10 until an operator actually PATCHes
/// something or pauses. See `settings/types.ts`'s doc comment for which
/// parameters were chosen and why (stateless thresholds only -- timer/
/// window durations that interact with an already-running persisted
/// countdown in `ExitState` stay frozen in `config`, restart-only).
model BotSettings {
  id                   String   @id @default("singleton")
  /// True = the 30-min screening cycle skips entirely (no new
  /// deployments). Monitoring and exit are NEVER affected by this flag --
  /// see `composition/screeningCycle.ts`'s doc comment.
  paused               Boolean  @default(false)
  /// Fraction 0-1 -- replaces CAPITAL.POSITION_SIZE_PCT_OF_FREE_BALANCE (0.35).
  positionSizePct      Float    @default(0.35)
  /// Replaces CAPITAL.MAX_ACTIVE_POSITIONS (3).
  maxActivePositions   Int      @default(3)
  /// Fraction, always negative -- replaces EXITS.HARD_STOP_LOSS_PCT.
  /// TIER 3: default -0.15 -> -0.06, Meridian's measured stop. No longer
  /// cross-validated against the Safety Exit trigger at the settings-range
  /// level: under the Meridian ladder the stop is deliberately TIGHTER
  /// than the -8% arming point, so the old "must be looser than -8%"
  /// range rule encoded a policy that no longer exists (removed).
  /// P0-3: this does NOT mean Hard Stop always overrides Safety Exit --
  /// `exits/resolveExitDecision.ts` now has Hard Stop YIELD once Safety
  /// Exit has armed (this tick or a prior one), so Safety Exit's own
  /// "arm at -8%, wait for recovery to 0%" semantics are genuinely
  /// reachable via a price gap or a failed/retried Hard Stop close --
  /// see that file's doc comment for the full mechanism and history.
  hardStopLossPct      Float    @default(-0.06)
  /// Fraction, always positive -- replaces EXITS.TRAILING_TP.TRIGGER_PEAK_PNL_PCT.
  /// TIER 3: default 0.05 -> 0.06, Meridian's measured trailing arm.
  trailingTpTriggerPct Float    @default(0.06)
  updatedAt            DateTime @updatedAt
}
